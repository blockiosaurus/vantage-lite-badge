{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vantage-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Your Worker's public https origin: Solana Pay links point here.
    "PUBLIC_ORIGIN": "https://vantage-lite.example.workers.dev",
    // The app id in the badge's app.json. Signed badge requests must name it.
    "BADGE_APP_ID": "vantage-lite",
    // "false" only for local development: lets curl hit /v1/* without badge signatures.
    "REQUIRE_BADGE_SIGNATURE": "true",
    "JUPITER_ORIGIN": "https://lite-api.jup.ag",
    "SOLANA_RPC_URL": "https://api.mainnet-beta.solana.com"
  },
  // Secrets (wrangler secret put):
  //   ANTHROPIC_API_KEY  optional, turns on Ask Vantage
  //   JUPITER_API_KEY    optional, use with JUPITER_ORIGIN=https://api.jup.ag
  "durable_objects": {
    "bindings": [
      { "name": "SWAPS", "class_name": "SwapIntent" },
      { "name": "LIMITS", "class_name": "DailyLimit" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SwapIntent", "DailyLimit"] }]
}
